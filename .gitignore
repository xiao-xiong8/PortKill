# Keep only source trees, build metadata, and required runtime assets at the root.
/*
!/.gitignore
!/.editorconfig
!/.gitattributes
!/Directory.Build.props
!/Directory.Build.targets
!/Directory.Packages.props
!/global.json
!/*.sln
!/*.slnx
!/src/
!/tests/
!/scripts/
!/deploy/

# Generated output and local tooling.
**/bin/
**/obj/
**/__pycache__/
**/.venv/
**/node_modules/
**/.vs/
**/.idea/
**/.vscode/
*.user
*.suo
*.pyc
*.pdb
*.exe
*.dll
*.zip
*.7z
*.bak
*.tmp
*.log
*.dmp
*.dump
*.db
*.sqlite

# Personal notes and reports. Font license texts are required runtime resources.
*.md
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx
*.jsonl
*.csv

# Never publish local service settings, credentials, or signing material.
.env
.env.*
*.local.json
*.local.toml
*.local.yaml
*.local.yml
update-settings*.json
appsettings.*.json
credentials*.json
secrets*.json
*.pem
*.key
*.pfx
*.p12
*.jks
*.pub
id_rsa*
id_ed25519*
**/.ssh/
