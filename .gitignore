# Keep only source trees, build metadata, and required runtime assets at the root.
/*
!/.gitignore
!/.editorconfig
!/.gitattributes
!/Directory.Build.props
!/Directory.Build.targets
!/Directory.Packages.props
!/global.json
!/*.sln
!/*.slnx
!/src/
!/tests/
!/scripts/
!/deploy/

# Generated output and local tooling.
/.local/
/aotpush/
/updatepush/
**/bin/
**/obj/
**/__pycache__/
**/.venv/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/node_modules/
**/dist/
**/.vite/
**/coverage/
**/playwright-report/
**/test-results/
**/TestResults/
**/.vs/
**/.idea/
**/.vscode/
*.user
*.suo
*.pyc
*.trx
*.tsbuildinfo
*.pdb
*.exe
*.dll
*.zip
*.7z
*.bak
*.tmp
*.log
*.dmp
*.dump
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Personal notes and reports. Font license texts are required runtime resources.
*.md
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx
*.jsonl
*.csv

# Never publish local service settings, credentials, or signing material.
.env
.env.*
*.local.json
*.local.toml
*.local.yaml
*.local.yml
**/Properties/launchSettings.json
update-settings*.json
appsettings.*.json
credentials*.json
secrets*.json
*.pem
*.key
*.pfx
*.p12
*.jks
*.pub
id_rsa*
id_ed25519*
**/.ssh/

# Public documentation and non-secret deployment examples only.
!/README.md
!deploy/examples/update-settings.example.json
!/docs/
/docs/*
!/docs/AUTO-UPDATE.md
!/docs/ARCHITECTURE.md
!/docs/RELEASE-NOTES.txt
