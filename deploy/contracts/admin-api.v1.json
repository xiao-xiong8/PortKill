  "components": {
    "schemas": {
      "AccountStateRequest": {
        "required": [
          "disabled"
        ],
        "type": "object",
        "properties": {
          "disabled": {
            "type": "boolean"
          }
        }
      },
      "AccountView": {
        "required": [
          "id",
          "userName",
          "disabled",
          "mfaEnabled",
          "recoveryAcknowledged",
          "roles"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userName": {
            "type": "string"
          },
          "disabled": {
            "type": "boolean"
          },
          "mfaEnabled": {
            "type": "boolean"
          },
          "recoveryAcknowledged": {
            "type": "boolean"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AuditEvent": {
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int64"
          },
          "actorUserId": {
            "type": "string",
            "nullable": true
          },
          "action": {
            "type": "string"
          },
          "resourceId": {
            "type": "string",
            "nullable": true
          },
          "result": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "remoteAddress": {
            "type": "string",
            "nullable": true
          },
          "createdUtcMs": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int64"
          }
        }
      },
      "AuthenticationResponse": {
        "required": [
          "next",
          "phase"
        ],
        "type": "object",
        "properties": {
          "next": {
            "type": "string"
          },
          "phase": {
            "$ref": "#/components/schemas/SessionPhase"
          }
        }
      },
      "AuthenticatorCodeRequest": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "CapabilitiesResponse": {
        "required": [
          "uploadStates",
          "validationStates",
          "publishStates"
        ],
        "type": "object",
        "properties": {
          "uploadStates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadState"
            }
          },
          "validationStates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationState"
            }
          },
          "publishStates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublishJobState"
            }
          }
        }
      },
      "ChangePasswordRequest": {
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        }
      },
      "ChangeRolesRequest": {
        "required": [
          "roles"
        ],
        "type": "object",
        "properties": {
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CreateAccountRequest": {
        "required": [
          "userName",
          "password",
          "roles"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
