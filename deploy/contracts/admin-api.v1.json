    "/api/v1/auth/mfa/recovery": {
      "post": {
        "tags": [
          "PortKiller.UpdateAdmin.Api"
        ],
        "operationId": "UseRecoveryCode",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecoveryCodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticationResponse"
