  },
  "components": {
    "schemas": {
      "AuthenticationResponse": {
        "required": [
          "next",
          "phase"
        ],
        "type": "object",
        "properties": {
          "next": {
            "type": "string"
          },
          "phase": {
            "$ref": "#/components/schemas/SessionPhase"
          }
        }
      },
      "AuthenticatorCodeRequest": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "CapabilitiesResponse": {
        "required": [
          "uploadStates",
          "validationStates",
          "publishStates"
        ],
        "type": "object",
        "properties": {
          "uploadStates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadState"
            }
          },
          "validationStates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationState"
            }
          },
          "publishStates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublishJobState"
            }
          }
        }
      },
      "EnrollmentSecret": {
        "required": [
          "sharedKey",
          "authenticatorUri"
        ],
        "type": "object",
        "properties": {
          "sharedKey": {
            "type": "string"
          },
          "authenticatorUri": {
            "type": "string"
          }
        }
      },
      "LiveHealthResponse": {
        "required": [
          "status",
          "component"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "component": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "userName",
          "password"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "PublishJobState": {
        "enum": [
          "queued",
          "publishing",
          "manifestActivated",
          "publicVerifying",
          "completed",
          "activeUnverified",
          "failed",
          "conflict",
          "superseded"
        ]
      },
      "ReauthenticationRequest": {
        "required": [
          "password",
          "code"
        ],
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "RecoveryAcknowledgementRequest": {
        "required": [
          "acknowledged"
        ],
        "type": "object",
        "properties": {
          "acknowledged": {
            "type": "boolean"
          }
        }
      },
      "RecoveryCodeRequest": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "RecoveryCodesResponse": {
        "required": [
          "recoveryCodes"
        ],
        "type": "object",
        "properties": {
          "recoveryCodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SessionPhase": {
        "enum": [
          "enrollmentRequired",
          "recoveryAcknowledgementRequired",
          "mfaRequired",
          "full"
        ]
      },
      "SystemStatusResponse": {
        "required": [
          "application",
          "version",
          "contractVersion"
        ],
        "type": "object",
        "properties": {
          "application": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "contractVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32"
          }
        }
      },
      "UploadState": {
        "enum": [
          "uploading",
          "uploaded",
          "cancelled",
          "expired"
        ]
      },
      "ValidationState": {
        "enum": [
          "pending",
          "validating",
          "readyForApproval",
          "rejected"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "PortKiller.UpdateAdmin.Api"
    }
  ]
}
