{
  "openapi": "3.0.4",
  "info": {
    "title": "PortKill Update Administration API",
    "version": "v1"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "PortKiller.UpdateAdmin.Api"
        ],
        "operationId": "GetLiveHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveHealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/status": {
      "get": {
        "tags": [
          "PortKiller.UpdateAdmin.Api"
        ],
        "operationId": "GetSystemStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatusResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/capabilities": {
      "get": {
        "tags": [
          "PortKiller.UpdateAdmin.Api"
        ],
        "operationId": "GetCapabilities",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CapabilitiesResponse": {
        "required": [
          "uploadStates",
          "validationStates",
          "publishStates"
        ],
        "type": "object",
        "properties": {
          "uploadStates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadState"
            }
          },
          "validationStates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationState"
            }
          },
          "publishStates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublishJobState"
            }
          }
        }
      },
      "LiveHealthResponse": {
        "required": [
          "status",
          "component"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "component": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "PublishJobState": {
        "enum": [
          "queued",
          "publishing",
          "manifestActivated",
          "publicVerifying",
          "completed",
          "activeUnverified",
          "failed",
          "conflict",
          "superseded"
        ]
      },
      "SystemStatusResponse": {
        "required": [
          "application",
          "version",
          "contractVersion"
        ],
        "type": "object",
        "properties": {
          "application": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "contractVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32"
          }
        }
      },
      "UploadState": {
        "enum": [
          "uploading",
          "uploaded",
          "cancelled",
          "expired"
        ]
      },
      "ValidationState": {
        "enum": [
          "pending",
          "validating",
          "readyForApproval",
          "rejected"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "PortKiller.UpdateAdmin.Api"
    }
  ]
}
