# Set to the existing Compose project name (docker compose ls).
MONITOR_COMPOSE_PROJECT=portkill
MONITOR_API_URL=http://api:5081/health/ready
MONITOR_API_HOST=admin.example.com
MONITOR_NOTIFIER_URL=http://notifier:8091/health
MONITOR_DOWNLOAD_URL=https://updates.example.com/stable/manifest.json
# Recommended on hosts restricting /host/proc/1/net/route. Example: eth0 or ens3.
MONITOR_INTERFACE=
MONITOR_DATA_ROOT=/host/data
MONITOR_PUBLIC_ROOT=/host/public
MONITOR_OUTPUT=/snapshot/status.json
