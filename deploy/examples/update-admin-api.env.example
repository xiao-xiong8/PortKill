# Non-secret environment for portkiller-update-api.service.
DOTNET_ENVIRONMENT=Production
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5081
urls=http://127.0.0.1:5081
Administration__DataRoot=/var/lib/portkiller-updates/admin
UpdateTool__Enabled=false
UpdateTool__ExecutablePath=/opt/portkiller-updates/tool/PortKiller.UpdateTool
UpdateTool__VerificationConfigPath=/etc/portkiller-updates/verification.json
UpdateTool__ReleaseRoot=/srv/portkiller-updates/stable
UpdateTool__TimeoutSeconds=45
UpdateTool__PublicCheckTimeoutSeconds=300
UpdateTool__MaximumOutputBytes=65536
