# Management site template. Replace the host name and certificate paths before enabling.
# The API remains loopback-only; this proxy is the only public management entry point.
server {
    listen 80;
    server_name admin.example.com;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name admin.example.com;

    ssl_certificate /etc/letsencrypt/live/admin.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:PortKillAdminTls:10m;
    ssl_session_timeout 10m;

    root /opt/portkiller-updates/web;
    index index.html;
    server_tokens off;
    client_max_body_size 257m;
    client_body_timeout 15m;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Keep API errors as JSON. This location has no SPA fallback.
    location = /health/live {
        proxy_pass http://127.0.0.1:5081/health/live;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_buffering off;
        proxy_redirect off;
    }

    # The management SSE has a bounded server lifetime and must not be buffered.
    location ~ ^/api/v1/jobs/[^/]+/events/stream$ {
        proxy_pass http://127.0.0.1:5081;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_set_header Accept-Encoding "";
        gzip off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 700s;
        proxy_send_timeout 15s;
        proxy_redirect off;
    }

    # Keep the prefix without ^~ so the SSE regex above can disable buffering.
    # Includes streaming uploads and all JSON API routes. Do not add try_files here.
    location /api/v1/ {
        proxy_pass http://127.0.0.1:5081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 90s;
        proxy_send_timeout 15m;
        proxy_redirect off;
    }

    # Avoid returning the SPA for a malformed API base request.
    location = /api/v1 {
        proxy_pass http://127.0.0.1:5081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_buffering off;
        proxy_redirect off;
    }

    location = /index.html {
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
