<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>PortKiller</AssemblyName>
    <RootNamespace>PortKiller</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 令牌特权调整 (AdjustTokenPresent) 等底层 API 需要指针直写结构体 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 可执行文件外观与元数据（资源管理器图标 / 属性页版本信息） -->
    <ApplicationIcon>Assets\avalonia-logo.ico</ApplicationIcon>
    <Version>0.1</Version>
    <ProductName>PortKiller</ProductName>
    <AssemblyTitle>PortKiller · 端口占用排查与释放</AssemblyTitle>
    <Description>Windows 端口占用监控与清理工具（Avalonia + Native AOT）</Description>
    <!-- Native AOT 支持与编译绑定：零JIT、极速冷启与独立可执行文件 -->
    <PublishAot>true</PublishAot>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <OptimizationPreference>Size</OptimizationPreference>
    <!-- 去除体积巨大的非托管PDB符号文件 -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PortKiller.Regression" />
    <InternalsVisibleTo Include="PortKiller.MemoryProbe" />
    <AvaloniaResource Include="Assets\**" />
    <None Include="../Modules/PortKiller.Updates/Configuration/production-feed.json" Link="update-settings.json"
          CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PortKiller.Core/PortKiller.Core.csproj" />
    <ProjectReference Include="../PortKiller.Infrastructure.Windows/PortKiller.Infrastructure.Windows.csproj" />
    <ProjectReference Include="../Modules/PortKiller.Modules.Ports/PortKiller.Modules.Ports.csproj" />
    <ProjectReference Include="../Modules/PortKiller.Updates/PortKiller.Updates.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <Target Name="RemovePdbFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
